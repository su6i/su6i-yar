# su6i-yar Configuration Example
# Copy this to .env and fill in the values

# --- Telegram API (Required for large video fallback) ---
# Get these from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Run setup_pyrogram.py to generate this
TG_SESSION_STRING=

# --- Bot Tokens ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_DEV=
ADMIN_ID=

# --- Path Overrides (Optional) ---
# By default, the bot calculates the path to amir-cli relative to its own location.
# Use this only if amir-cli is located outside the standard directory structure.
# AMIR_PATH=/path/to/amir-cli/amir

# Default browser for cookies (set to "none" for headless Linux servers)
AMIR_DEFAULT_BROWSER=none

# --- Features & APIs ---
GEMINI_API_KEY=
PEXELS_API_KEY=
FAL_KEY=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- Channels ---
ARMAGEDDON_CHANNEL_DEV=fin_ml
ARMAGEDDON_CHANNEL_PROD=armageddon_war
